# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App-Level Token for Socket Mode (xapp-...)
# Required for Socket Mode (local development without a public URL)
SLACK_APP_TOKEN=xapp-your-app-token

# Slack Signing Secret (from App Settings > Basic Information)
SLACK_SIGNING_SECRET=your-signing-secret

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your-api-key

# Model to use via OpenRouter (default: anthropic/claude-haiku-4-5)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Server port (HTTP mode only, ignored in Socket Mode)
PORT=3000
